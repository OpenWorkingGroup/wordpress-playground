{
  "folders": [{ "name": "Workspace", "path": "." }],
  "extensions": { "recommendations": ["WordPressPlayground.wordpress-playground"] },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Workspace: Set up",
        "dependsOrder": "sequence",
        "dependsOn": ["Setup: Validate configuration", "Setup: WP-CLI", "Setup: Prepare WordPress"],
        "problemMatcher": []
      },
      {
        "label": "Setup: Validate configuration",
        "type": "process", "command": "node",
        "args": ["${workspaceFolder:Workspace}/tools/wordpress-playground/scripts/workspace.mjs", "validate", "${workspaceFolder:Workspace}/workspace.json"],
        "problemMatcher": []
      },
      {
        "label": "Setup: WP-CLI",
        "type": "process", "command": "sh",
        "args": ["${workspaceFolder:Workspace}/tools/wordpress-playground/scripts/setup-packaging.sh"],
        "problemMatcher": []
      },
      {
        "label": "Setup: Prepare WordPress",
        "type": "process", "command": "node",
        "args": ["${workspaceFolder:Workspace}/tools/wordpress-playground/scripts/workspace.mjs", "prepare", "${workspaceFolder:Workspace}/workspace.json"],
        "problemMatcher": []
      }
    ]
  }
}

{
  "folders": [
    {
      "name": "Framework",
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "WordPressPlayground.wordpress-playground"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Project: Set up",
        "type": "process",
        "command": "node",
        "args": [
          "${workspaceFolder:Framework}/scripts/setup-project.mjs"
        ],
        "problemMatcher": []
      },
      {
        "label": "Framework: Set up WP-CLI",
        "type": "process",
        "command": "sh",
        "args": [
          "${workspaceFolder:Framework}/scripts/setup-packaging.sh"
        ],
        "problemMatcher": []
      },
      {
        "label": "Framework: Test",
        "type": "process",
        "command": "npm",
        "args": [
          "test"
        ],
        "options": {
          "cwd": "${workspaceFolder:Framework}"
        },
        "dependsOn": [
          "Framework: Set up WP-CLI"
        ],
        "problemMatcher": []
      }
    ]
  }
}

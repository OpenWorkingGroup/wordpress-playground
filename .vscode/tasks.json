{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Package component",
      "type": "process",
      "command": "sh",
      "args": ["${workspaceFolder}/tooling/scripts/package-extension.sh", "${input:kind}", "${workspaceFolder}/${input:source}", "${workspaceFolder}/tooling/dist"],
      "dependsOn": ["Packaging: Prepare WP-CLI"],
      "problemMatcher": []
    },
    {
      "label": "Packaging: Prepare WP-CLI",
      "type": "process",
      "command": "sh",
      "args": ["${workspaceFolder}/tooling/scripts/setup-packaging.sh"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "kind", "type": "pickString", "description": "Component type", "options": ["plugin", "theme"], "default": "plugin" },
    { "id": "source", "type": "promptString", "description": "Component folder relative to this project (for example plugins/my-plugin)", "default": "plugins/my-plugin" }
  ]
}
